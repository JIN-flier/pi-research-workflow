+[project]
+name = "mnist-light"
+version = "0.1.0"
+description = "Lightweight CPU-only MNIST MLP vs CNN experiment (EXP-0001)"
+requires-python = ">=3.12,<3.13"
+dependencies = [
+    "numpy>=2.0",
+    "torch>=2.4",
+    "torchvision>=0.19",
+]
+
+[dependency-groups]
+dev = [
+    "pytest>=8.0",
+]
+
+[build-system]
+requires = ["hatchling"]
+build-backend = "hatchling.build"
+
+[tool.hatch.build.targets.wheel]
+packages = ["mnist_light"]
+
+[tool.uv]
+# CPU-only PyTorch: never resolve CUDA wheels for this experiment.
+[[tool.uv.index]]
+name = "pytorch-cpu"
+url = "https://download.pytorch.org/whl/cpu"
+explicit = true
+
+[tool.uv.sources]
